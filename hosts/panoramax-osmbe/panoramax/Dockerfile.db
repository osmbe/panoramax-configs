# Custom database image: PostGIS + pgBackRest.
#
# We add pgBackRest at the OS level (apt) so it can use the same data
# directory as Postgres for the `archive_command` in postgresql.conf.
# (Building it as a separate side-car would complicate WAL streaming.)
#
# The PostGIS major version is the SINGLE SOURCE OF TRUTH for the database
# version. Bump per upstream Panoramax release notes; coordinate with a
# pg_upgrade step.
FROM postgis/postgis:16-3.6

# The 16-3.6 images moved to Debian trixie, whose pgbackrest (2.55.x)
# understands PostgreSQL 16 and the repo1-block/repo1-bundle options in
# pgbackrest.conf. The older 16-3.4/16-3.5 images were Debian bullseye,
# which is EOL and can no longer provide a PG16-capable pgbackrest —
# Debian's last bullseye build (2.33) predates PG16 and PGDG dropped the
# bullseye dist (postgis/docker-postgis#462). Moving bases changes glibc
# under the data directory, so this image needs a dump/restore migration,
# not a drop-in swap: see OPERATIONS.md § Migrating the db image across
# Debian releases.
RUN apt-get update \
    && apt-get install -y --no-install-recommends pgbackrest \
    && rm -rf /var/lib/apt/lists/*
