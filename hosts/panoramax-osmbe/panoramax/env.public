# =============================================================================
# Public (committed) compose env vars for the Panoramax stack.
# =============================================================================
# At service start, panoramax-env-merge.service concatenates this file with the
# decrypted /run/secrets/panoramax/env (OAUTH_CLIENT_SECRET, FLASK_SECRET_KEY,
# PG_PASSWORD, etc.) and writes the result to /run/panoramax.env, which the
# compose stack consumes via `env_file`.
#
# Replace SET-ME-… values to match your fork. If you fork to a different
# domain, update DOMAIN, the API_*_PUBLIC_URL pair, and FLASK_SESSION_COOKIE_DOMAIN.
# =============================================================================

# -- Domain / branding ----------------------------------------------------
DOMAIN=panoramax.osm.be
INSTANCE_NAME=Panoramax Belgium
FLASK_SESSION_COOKIE_DOMAIN=panoramax.osm.be

# -- Image build pins -----------------------------------------------------
# API + background-worker share the same image/tag. Website is released
# separately and has its own tag.
GEOVISIO_IMAGE_TAG=2.15.0
GEOVISIO_WEBSITE_IMAGE_TAG=3.4.1

# -- API mode -------------------------------------------------------------
OAUTH_PROVIDER=osm
API_FORCE_AUTH_ON_UPLOAD=true
API_REGISTRATION_IS_OPEN=True
API_ENFORCE_TOS_ACCEPTANCE=True
API_PICTURES_LICENSE_SPDX_ID=CC-BY-SA-4.0
API_PICTURES_LICENSE_URL=https://spdx.org/licenses/CC-BY-SA-4.0.html

# Image processing & blurring (OSM-FR public endpoint until self-hosted).
API_BLUR_URL=https://blur.panoramax.openstreetmap.fr
PICTURE_PROCESS_DERIVATES_STRATEGY=PREPROCESS
PICTURE_PROCESS_THREADS_LIMIT=0
PICTURE_WORKERS_REPLICATS=5

# Public image URLs. The English `/derivatives/` is an nginx alias to the
# internal French `derivates/` directory.
API_PERMANENT_PICTURES_PUBLIC_URL=https://images.panoramax.osm.be/permanent
API_DERIVATES_PICTURES_PUBLIC_URL=https://images.panoramax.osm.be/derivatives

# -- Filesystem layout (THREE-PATH MODE) ----------------------------------
# tmp on local disk, permanent + derivates on NFS. The Dockerfile sets
# ENV FS_URL=/data/geovisio, so we MUST set FS_URL= empty here to switch off
# single-path mode (the three FS_*_URL vars and FS_URL are mutually exclusive).
FS_URL=
FS_TMP_URL=/data/tmp
FS_PERMANENT_URL=/data/geovisio/permanent
FS_DERIVATES_URL=/data/geovisio/derivates

# -- Database -------------------------------------------------------------
# Migrations container handles schema upgrades. API skips schema-check to
# avoid a yoyo_lock deadlock when both run concurrently.
DB_CHECK_SCHEMA=False

# -- Proxy hops -----------------------------------------------------------
# Caddy + compose-internal nginx → 2 trusted proxy hops in front of Flask.
INFRA_NB_PROXIES=2

# -- API threading --------------------------------------------------------
NB_API_THREADS=10

# -- Multilingual instance summary (en/fr/nl) -----------------------------
API_SUMMARY={"color":"#cd1f2d","email":"panoramax@osm.be","logo":"https://panoramax.osm.be/logo.png","name":{"en":"Panoramax Belgium","fr":"Panoramax Belgique","nl":"Panoramax België"},"description":{"en":"Open street-level imagery for OpenStreetMap Belgium.","fr":"Images publiques de niveau de rue pour OpenStreetMap Belgique.","nl":"Open afbeeldingen op straatniveau voor OpenStreetMap België."},"geo_coverage":{"en":"Belgium","fr":"Belgique","nl":"België"}}

# -- Website (Vite) -------------------------------------------------------
VITE_INSTANCE_NAME=Panoramax Belgium
VITE_API_URL=/
VITE_TILES=https://panoramax.openstreetmap.fr/pmtiles/basic.json
VITE_CENTER=4.35,50.85
VITE_ZOOM=8
VITE_TITLE=Panoramax Belgium — open street-level imagery for OSM Belgium
VITE_META_TITLE=Panoramax Belgium
VITE_META_DESCRIPTION=Open street-level imagery for OpenStreetMap Belgium.
